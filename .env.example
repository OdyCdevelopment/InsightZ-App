DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:3306/offers
REDIS_URL=redis://localhost:6379/0
# Leave empty to use free rule-based extraction (recommended).
LLM_API_KEY=
# auto = rule when no key, llm when key present | rule | llm
EXTRACTION_MODE=auto
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ENVIRONMENT=development
DEFAULT_CRAWL_RATE_LIMIT_SECONDS=2.5
USER_AGENT=SriLankaOfferBot/1.0 (+mailto:you@example.com)
PLAYWRIGHT_POOL_SIZE=2
CORS_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=120
