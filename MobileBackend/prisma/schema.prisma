  period       String   @db.VarChar(100)
  type         String   @db.VarChar(50) // revenue_summary | commission_report | tax_report | pl_statement
  generated_by String?  @db.VarChar(255)
  generated_at DateTime @default(now()) @db.Timestamp(6)
}

// ─────────────────────────────────────────────
// SUPPORT — CONTACT MESSAGES
// ─────────────────────────────────────────────

model contact_messages {
  id          Int      @id @default(autoincrement())
  sender_name String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  subject     String   @db.VarChar(500)
  message     String
  status      String   @default("new") @db.VarChar(20) // new | read | replied
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([status])
}

// ─────────────────────────────────────────────
// SECURITY — LOGIN ATTEMPTS
// ─────────────────────────────────────────────

model login_attempts {
  id            Int      @id @default(autoincrement())
  admin_user_id Int?
  username      String?  @db.VarChar(100)
  ip_address    String?  @db.VarChar(45)
  device        String?  @db.VarChar(255)
  status        String   @db.VarChar(20) // success | failed | suspicious
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([status])
  @@index([created_at])
}

// ─────────────────────────────────────────────
// SYSTEM — API LOGS / BACKUPS
// ─────────────────────────────────────────────

model api_request_logs {
  id          BigInt   @id @default(autoincrement())
  api_key_id  Int?
  endpoint    String   @db.VarChar(500)
  status_code Int
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([api_key_id])
  @@index([created_at])
}

model backups {
  id           Int       @id @default(autoincrement())
  type         String    @db.VarChar(20) // daily | weekly_full | monthly_archive
  file_path    String?   @db.VarChar(1000)
  size_bytes   BigInt?
  status       String    @default("in_progress") @db.VarChar(20) // completed | failed | in_progress
  duration_ms  Int?
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
}
